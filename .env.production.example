# Copiar a .env.production EN EL SERVIDOR (o inyectar en el process manager)
# antes de `npm run build` si usas NEXT_PUBLIC_*.
#
# API_URL no es NEXT_PUBLIC: el servidor Next la lee en runtime.
# Apunta al NestJS de esta misma máquina, con /api y sin barra final.

API_URL=http://127.0.0.1:403/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:403/api

# El proxy público debe ir al front (404), NO al back.
# Así el login en Network es https://TU-DOMINIO/api/admin/login
# y nunca http://localhost:...
